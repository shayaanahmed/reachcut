#!/bin/sh
set -u

AGENT_ID="__REACHCUT_AGENT_ID__"
CONSOLE_UID="$(stat -f '%u' /dev/console 2>/dev/null || true)"
PLIST_PATH="/Library/LaunchAgents/$AGENT_ID.plist"

case "$CONSOLE_UID" in
  ''|*[!0-9]*|0) ;;
  *)
    launchctl bootstrap "gui/$CONSOLE_UID" "$PLIST_PATH" >/dev/null 2>&1 || true
    launchctl kickstart -k "gui/$CONSOLE_UID/$AGENT_ID" >/dev/null 2>&1 || true
    ;;
esac

exit 0
