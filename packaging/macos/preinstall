#!/bin/sh
set -u

AGENT_ID="__REACHCUT_AGENT_ID__"
APP_BUNDLE="__REACHCUT_APP_BUNDLE__"
CONSOLE_UID="$(stat -f '%u' /dev/console 2>/dev/null || true)"

case "$CONSOLE_UID" in
  ''|*[!0-9]*|0) ;;
  *) launchctl bootout "gui/$CONSOLE_UID/$AGENT_ID" >/dev/null 2>&1 || true ;;
esac

pkill -f "/Applications/$APP_BUNDLE/Contents/Resources/app/scripts/reachcut-agent.mjs" \
  >/dev/null 2>&1 || true

exit 0
