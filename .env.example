CLIPPER_DATA_DIR=./data
CLIPPER_DATABASE_URL=sqlite:///./data/clipper.db

# Speech-to-text: faster-whisper is currently the supported transcription adapter.
CLIPPER_TRANSCRIPTION_PROVIDER=faster-whisper
CLIPPER_WHISPER_MODEL=large-v3-turbo
CLIPPER_WHISPER_DEVICE=cpu
CLIPPER_WHISPER_COMPUTE_TYPE=int8

# Text reasoning: Ollama is currently the supported editorial adapter.
CLIPPER_EDITORIAL_PROVIDER=ollama
CLIPPER_EDITORIAL_BASE_URL=http://127.0.0.1:11434
CLIPPER_DOCKER_EDITORIAL_BASE_URL=http://host.docker.internal:11434
CLIPPER_EDITORIAL_MODEL=qwen3:8b-q4_K_M
CLIPPER_EDITORIAL_TIMEOUT_SECONDS=600
CLIPPER_EDITORIAL_NUM_CTX=8192
CLIPPER_EDITORIAL_NUM_PREDICT=2048
CLIPPER_EDITORIAL_RETRY_NUM_CTX=16384
CLIPPER_EDITORIAL_RETRY_NUM_PREDICT=4096

CLIPPER_MAX_UPLOAD_BYTES=8589934592
CLIPPER_MAX_DURATION_SECONDS=21600
CLIPPER_WEB_PORT=3000
CLIPPER_API_PORT=8000
CLIPPER_BROWSER_API_URL=http://127.0.0.1:8000/api
