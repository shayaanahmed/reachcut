CLIPPER_DATA_DIR=./data
CLIPPER_DATABASE_URL=sqlite:///./data/clipper.db

# Speech-to-text: faster-whisper is currently the supported transcription adapter.
CLIPPER_TRANSCRIPTION_PROVIDER=faster-whisper
CLIPPER_WHISPER_MODEL=large-v3-turbo
CLIPPER_WHISPER_DEVICE=cpu
CLIPPER_WHISPER_COMPUTE_TYPE=int8

# Text reasoning: Ollama is currently the supported editorial adapter.
CLIPPER_EDITORIAL_PROVIDER=ollama
CLIPPER_EDITORIAL_BASE_URL=http://127.0.0.1:11434
CLIPPER_DOCKER_EDITORIAL_BASE_URL=http://host.docker.internal:11434
CLIPPER_EDITORIAL_MODEL=qwen3:8b-q4_K_M
CLIPPER_EDITORIAL_TIMEOUT_SECONDS=600
CLIPPER_EDITORIAL_NUM_CTX=8192
CLIPPER_EDITORIAL_NUM_PREDICT=2048
CLIPPER_EDITORIAL_RETRY_NUM_CTX=16384
CLIPPER_EDITORIAL_RETRY_NUM_PREDICT=4096

# Local sampled face/action tracking. Set to disabled to skip visual analysis.
CLIPPER_TRACKING_PROVIDER=opencv
CLIPPER_TRACKING_SAMPLE_INTERVAL_SECONDS=0.5

CLIPPER_MAX_UPLOAD_BYTES=8589934592
CLIPPER_MAX_SECONDARY_MEDIA_BYTES=2147483648
CLIPPER_MAX_DURATION_SECONDS=21600
CLIPPER_YT_DLP_REPOSITORY=../yt-dlp
CLIPPER_YT_DLP_TIMEOUT_SECONDS=3600
# Comma-separated public hosts accepted by URL import.
CLIPPER_YT_DLP_ALLOWED_HOSTS=youtube.com,youtu.be,vimeo.com,tiktok.com,twitch.tv,instagram.com,facebook.com,x.com,twitter.com
CLIPPER_WEB_PORT=3000
CLIPPER_API_PORT=8000
CLIPPER_BROWSER_API_URL=http://127.0.0.1:8000/api

# Social account connections
#
# These are workspace-level developer-app credentials, not credentials for a
# YouTube/TikTok/Instagram/Facebook/X user. ReachCut starts provider OAuth from
# Settings, discovers the authorized profile only after the callback succeeds,
# and stores the resulting user tokens encrypted under CLIPPER_DATA_DIR.
#
# The callback registered in each provider portal must exactly match its value
# below. Never expose these secrets through NEXT_PUBLIC_* variables or commit a
# populated .env file.
CLIPPER_WEB_BASE_URL=http://127.0.0.1:3000

# YouTube: Google Cloud OAuth client, application type "Web application".
# Enable YouTube Data API v3 and request youtube.upload + youtube.readonly.
CLIPPER_YOUTUBE_CLIENT_ID=
CLIPPER_YOUTUBE_CLIENT_SECRET=
CLIPPER_YOUTUBE_REDIRECT_URI=http://127.0.0.1:8000/api/oauth/youtube/callback

# TikTok: use Desktop Login Kit with PKCE, then add Content Posting API and
# enable Direct Post. Desktop Login Kit accepts localhost/loopback callbacks.
CLIPPER_TIKTOK_CLIENT_KEY=
CLIPPER_TIKTOK_CLIENT_SECRET=
CLIPPER_TIKTOK_REDIRECT_URI=http://127.0.0.1:8000/api/oauth/tiktok/callback

# Instagram: Meta app with Facebook Login for Business and Instagram API.
# Local binary upload requires a professional Instagram account linked to a
# Facebook Page. Use the Meta app's general App ID/Secret, not Instagram Login's.
CLIPPER_INSTAGRAM_APP_ID=
CLIPPER_INSTAGRAM_APP_SECRET=
CLIPPER_INSTAGRAM_LOGIN_CONFIG_ID=
CLIPPER_INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/oauth/instagram/callback

# Facebook: dedicated Meta app using Facebook Login with Page permissions.
CLIPPER_FACEBOOK_APP_ID=
CLIPPER_FACEBOOK_APP_SECRET=
CLIPPER_FACEBOOK_LOGIN_CONFIG_ID=
CLIPPER_FACEBOOK_REDIRECT_URI=http://localhost:8000/api/oauth/facebook/callback

# X: OAuth 2.0 confidential Web App with read/write and offline access.
CLIPPER_X_CLIENT_ID=
CLIPPER_X_CLIENT_SECRET=
CLIPPER_X_REDIRECT_URI=http://127.0.0.1:8000/api/oauth/x/callback

# Keep the Graph API version explicit so upgrades are deliberate.
CLIPPER_GRAPH_API_VERSION=v26.0
